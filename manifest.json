{
  "manifest_version": 3,
  "name": "Coursera Quiz Helper",
  "version": "4.0.0",
  "author": "Rahul Gotrekiya",
  "description": "Reads a Coursera quiz, asks Gemini, and selects the answers on the page. You tick the honor code and submit yourself.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.coursera.org/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.coursera.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "commands": {
    "solve": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Answer the questions on this Coursera quiz"
    }
  }
}
